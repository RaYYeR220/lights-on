exports[`the landing > keeps the hero fold when the building cannot be loaded 1`] = `"<section class="_hero_f01584" aria-labelledby="hero-title"><div class="_copy_f01584"><h1 id="hero-title" class="_h1_f01584 rv">Know by morning if <br/>they&#x27;re still shipping.</h1><p class="_sub_f01584 rv d1">Every night an agent checks the projects you backed for work that actually reached users, attests the verdict on Base, and tells you by breakfast.</p><div class="_ctas_f01584 rv d2"><a class="btn btn-primary" href="/night">See last night&#x27;s shift</a><button type="button" class="btn btn-ghost">Check your bags</button></div><p class="_proof_f01584 rv d3"><span>Last night&#x27;s readings are not available right now.</span><span class="_legend_f01584" aria-label="Legend"><span><i class="sw sw-shipped" aria-hidden="true"></i>shipped</span><span><i class="sw sw-building" aria-hidden="true"></i>building</span><span><i class="sw sw-quiet" aria-hidden="true"></i>quiet</span><span><i class="sw sw-down" aria-hidden="true"></i>down</span></span></p></div><p class="_down_f01584">The building could not be loaded. It is rebuilt every 5 minutes, so try again shortly.</p></section>"`;
