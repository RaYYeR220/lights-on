# Server-only secrets
DATABASE_URL=
VENICE_API_KEY=
WATCHER_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VAPID_PRIVATE_KEY=
INTERNAL_RUN_TOKEN=
CRON_SECRET=
GITHUB_READ_TOKEN=

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_CHAIN_ID=8453

# Telegram: set the webhook once after deploy with `pnpm tsx scripts/telegram-set-webhook.ts`
# Web push: generate a pair with `pnpm exec web-push generate-vapid-keys`; the PUBLIC half goes in NEXT_PUBLIC_VAPID_PUBLIC_KEY, the private half in VAPID_PRIVATE_KEY (never commit either).
