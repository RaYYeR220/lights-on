# Every variable the app, the scripts and the tests read. Copy to .env.local for development.
# src/lib/env.ts checks these at server start (src/instrumentation.ts): on the production deployment
# (VERCEL_ENV=production) a missing REQUIRED variable or a malformed value stops the server with the list of names.

# ---- Server: required in production ----
# Neon Postgres (pooled). Tests use pglite://memory.
DATABASE_URL=
# Salt for requester hashes and the token on internal shift runs (/api/shift/run). Long random string.
INTERNAL_RUN_TOKEN=
# Vercel Cron bearer for /api/shift/dispatch and /api/shift/finalize-stale.
CRON_SECRET=

# ---- Server: optional (a missing one switches its feature off) ----
# Unpooled Neon URL, used by drizzle-kit migrate when set (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Venice API key for the AI explanation and briefing polish (status never depends on it).
VENICE_API_KEY=
# Watcher hot wallet (0x + 64 hex) that signs the EAS attestations. Never commit it.
WATCHER_PRIVATE_KEY=
# ERC-8004 agent id of the watcher (digits). Missing or 0: nothing is attested (`attestation: disabled`).
WATCHER_AGENT_ID=
# Base JSON-RPC for adapters and attestation (default https://base-rpc.publicnode.com).
BASE_RPC_URL=
# Ethereum mainnet JSON-RPC for ENS names on /b and get_briefing (ENS lookups are off when unset).
ETH_RPC_URL=
# Where the dispatcher sends internal shift runs (default NEXT_PUBLIC_SITE_URL). Must be the unprotected production domain.
INTERNAL_BASE_URL=
# Read-only GitHub token for repo checks (without it: the public Atom feed, 20 entries, no file lists).
GITHUB_READ_TOKEN=
# Telegram bot token and webhook secret; set the webhook after deploy with `pnpm tsx scripts/telegram-set-webhook.ts`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Web push private key; generate a pair with `pnpm exec web-push generate-vapid-keys` (never commit either half).
VAPID_PRIVATE_KEY=

# ---- Public (inlined into the browser bundle) ----
# Canonical https origin of the site: evidence URIs on chain, links, the live-run same-origin check. Required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web push public key (the other half of VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Attester allowlist for the in-browser Verify (comma-separated addresses): the watcher wallet's address.
NEXT_PUBLIC_WATCHER_ADDRESS=
# Base RPC the browser reads attestations from (default https://base-rpc.publicnode.com).
NEXT_PUBLIC_BASE_RPC_URL=
# Telegram bot username without @ (the /b subscribe link is hidden when unset).
NEXT_PUBLIC_TELEGRAM_BOT=

# ---- Scripts and tests only ----
# Local anvil fork for `scripts/*.ts --network fork` (default http://127.0.0.1:8546).
FORK_RPC_URL=
# Upstream RPC that `pnpm test:fork` forks with anvil (default https://base-rpc.publicnode.com).
FORK_URL=
# Playwright: port of the dev server it starts (default 3217), `start` to run against `pnpm build`, or an existing BASE_URL.
PORT=
E2E_SERVER=
BASE_URL=
